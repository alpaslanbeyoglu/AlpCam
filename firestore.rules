rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.keys().contains('email') && request.auth.token.email == 'alpaslan.beyoglu@gmail.com')
      ); 
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Catalog Rules - Read is public, write validates structure
    match /catalog/{lensId} {
      allow read: if true;
      allow write: if isValidLens(incoming());
    }

    function isValidLens(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.brand is string && data.brand.size() <= 200 &&
             data.name is string && data.name.size() <= 500 &&
             data.updatedAt is string;
    }

    // Discounts Rules - Public read and update for catalog discounts
    match /discounts/{brand} {
      allow read, write: if true;
    }

    // Custom Lists Rules
    match /customLists/{listId} {
      allow read: if true;
      allow write: if isValidCustomList(incoming());
    }

    function isValidCustomList(data) {
      return data.id is string && data.name is string && data.updatedAt is string;
    }

    // Processed Files Rules - Allows auto-sync to record sync status
    match /processedFiles/{fileId} {
      allow read, write: if true;
    }

    // Admins collection rules
    match /admins/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
